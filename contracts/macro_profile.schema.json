{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SeasonCake/lostcastle2-toolbox/main/contracts/macro_profile.schema.json",
  "title": "Lost Castle 2 Macro Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "enabled", "trigger", "limits", "steps"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "enabled": { "type": "boolean", "default": false },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "modifiers", "mode"],
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 16 },
        "modifiers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["CTRL", "ALT", "SHIFT"] }
        },
        "mode": { "enum": ["once", "hold_repeat", "toggle_repeat"] }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foreground_only", "max_runtime_ms", "repeat_delay_ms"],
      "properties": {
        "foreground_only": { "const": true },
        "max_runtime_ms": { "type": "integer", "minimum": 100, "maximum": 600000 },
        "repeat_delay_ms": { "type": "integer", "minimum": 20, "maximum": 60000 }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "key", "action", "hold_ms"],
            "properties": {
              "type": { "const": "key" },
              "key": { "type": "string", "minLength": 1, "maxLength": 16 },
              "action": { "const": "tap" },
              "hold_ms": { "type": "integer", "minimum": 20, "maximum": 10000 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "key", "action"],
            "properties": {
              "type": { "const": "key" },
              "key": { "type": "string", "minLength": 1, "maxLength": 16 },
              "action": { "enum": ["down", "up"] }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "duration_ms"],
            "properties": {
              "type": { "const": "wait" },
              "duration_ms": { "type": "integer", "minimum": 20, "maximum": 60000 }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "enabled": { "const": true } },
        "required": ["enabled"]
      },
      "then": {
        "properties": { "steps": { "minItems": 1 } }
      }
    }
  ]
}
