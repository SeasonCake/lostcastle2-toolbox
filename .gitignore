# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Local configuration and secrets
config/
.env
.env.*
!.env.example

# Build and release output
build/
dist/
package/
release_history/
*.spec
*.zip
*.log

# .NET / IDE output
.vs/
**/bin/
**/obj/
*.user
*.suo
*.pdb
*.dll

# Third-party binaries require explicit redistribution permission and are not source.
third_party/**/*.exe
third_party/**/*.zip
third_party/**/*.7z
third_party/**/*.rar
third_party/community_mods/

# The pinned 7-Zip runtime is redistributable under its bundled License.txt and
# is required for source-mode archive inspection.
!third_party/7zip/7z.exe
!third_party/7zip/7z.dll
!third_party/7zip/License.txt

# Local QA captures. Keep only the small written evidence summaries.
artifacts/**
!artifacts/**/
!artifacts/**/README.zh-CN.md

# Editor / operating system
.idea/
.vscode/
.DS_Store
Thumbs.db
